#!/usr/bin/env python3
"""brain-check — validate a Project Brain for integrity.

Checks:
  - every topic file has well-formed frontmatter with the required keys + a valid status
  - every pointer in index.md resolves to a file that actually exists
  - the status shown in index.md matches the status in the topic file (two-sources-of-truth drift)
  - topic files that exist on disk but are not linked from index.md (orphans)
  - provenance: `trust:` is valid (human | ai-inferred) when present
  - staleness: a verified/done topic past its `review_by:` (or older than the staleness horizon
    by `last_done:`) is flagged "re-confirm before trusting"
  - cross-project mix-ups: `project:` must match the folder the file lives under (always on)
  - (--strict only) a topic that name-drops another known project without declaring it in
    `cross_refs:` is flagged — off by default because tightly-coupled brains reference each
    other on purpose, and flagging every legitimate mention is just noise
  - warns on thin topics (< 300 B), over-long topics (> 40 body lines), over-fragmented
    projects (> 15 topics), and session-log overflow (> 5 active lines)
  - conflict detector: a single project that names two of the same mutually-exclusive tech
    (a relational DB, or a host) across its index stack and topic files — likely a stale fact.
    An aggregator topic (infra map, multi-repo roadmap) can opt a group out with frontmatter
    `allow_conflict: [relational-db]` so its legitimate multi-tech listing isn't flagged
  - people/<slug>.md: valid frontmatter (person/status/version), a relationship status
    (active|prospect|paused|closed), person matches the filename, staleness, and orphans

Backward compatible: the new provenance/staleness/cross-project/conflict signals are WARNINGS,
never errors, and only fire on fields a brain actually uses — older brains keep passing untouched.

Exit code: 0 = clean (warnings allowed), 1 = errors found.
No third-party dependencies — Python 3 stdlib only.

Usage:
  brain-check [PATH] [--strict] [--report] [--diff YYYY-MM-DD] [--fix]
      PATH      a .project-brain dir, a workspace containing one, or omitted (cwd)
      --strict  also flag cross-project name-drops in topic bodies (noisy on coupled brains)
      --report  print a grouped, readable report (staleness, conflicts, orphans, …) instead
                of a flat warning list — same checks, easier to scan
      --diff D  instead of validating, list what changed on/after date D — new/updated topics,
                session lines, resume lines, decisions, and people — from the brain's own dates
      --fix     apply the two MECHANICAL fixes before validating (everything else stays a
                human judgment call): regenerate a missing/stale index.compact, and rotate
                any project's _session.md past 5 active lines into _session.cold.md. Then
                runs the normal validation so you see what (if anything) still needs you.
"""
import os
import re
import sys
from datetime import date, datetime

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _compact  # noqa: E402  (shared dual-format index renderer, stdlib only)

VALID_STATUS = ["verified", "done", "in-progress", "failed", "superseded"]
PEOPLE_STATUS = ["active", "prospect", "paused", "closed"]   # relationship state for people/
VALID_TRUST = ["human", "ai-inferred", "pref"]   # human=FACT · ai-inferred · pref=preference
REQUIRED_KEYS = {"project", "topic", "status", "version"}
PEOPLE_REQUIRED = {"person", "status", "version"}
FINISHED_STATUS = {"verified", "done"}   # only finished claims can go "stale"
STALE_DAYS = 180                          # horizon used when a topic has no explicit review_by
THIN_BYTES = 300
MAX_BODY_LINES = 40                       # a topic longer than this wants splitting (memory hygiene)


def skill_version():
    """Version of THIS installed copy, from the SKILL.md sitting next to the script.

    Printed in the summary so a stale install (repo updated, install.sh not re-run)
    is visible instead of silently mis-validating — that drift produced real false
    positives once (allow_conflict existed in the repo but not in the installed copy).
    """
    try:
        text = read_text(os.path.join(os.path.dirname(os.path.abspath(__file__)), "SKILL.md"))
        m = re.search(r"^version:\s*(\S+)", text, re.M)
        return m.group(1) if m else None
    except Exception:
        return None


def find_brain(arg):
    cand = arg or "."
    if os.path.basename(os.path.normpath(cand)) == ".project-brain" and os.path.isdir(cand):
        return cand
    pb = os.path.join(cand, ".project-brain")
    if os.path.isdir(pb):
        return pb
    if os.path.isfile(os.path.join(cand, "index.md")):
        return cand
    return None


def read_text(path):
    with open(path, encoding="utf-8") as fh:
        return fh.read()


def parse_frontmatter(text):
    m = re.match(r"---\s*\n(.*?)\n---", text, re.S)
    if not m:
        return None
    fm = {}
    for line in m.group(1).splitlines():
        line = line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        k, _, v = line.partition(":")
        fm[k.strip()] = v.strip()
    return fm


def parse_date(s):
    try:
        return datetime.strptime(s.strip(), "%Y-%m-%d").date()
    except Exception:
        return None


def index_status(bracket):
    for s in VALID_STATUS:
        if re.search(r"\b" + re.escape(s) + r"\b", bracket):
            return s
    return None


def people_status(bracket):
    # word-boundary match: a plain substring test made "[inactive …]" read as "active"
    for s in PEOPLE_STATUS:
        if re.search(r"\b" + re.escape(s) + r"\b", bracket):
            return s
    return None


# --- conflict detector: mutually-exclusive tech a single project should not name two of ---
# Deliberately small and high-signal: a relational DB swap or a host swap is the classic
# "two places disagree" rot. Redis (a cache) is NOT here — it coexists with a real DB.
# Only unambiguous tokens — see the lesson below. "oracle" was removed because it matches
# component names like `oracle.py` / "oracle/scheduler" far more often than the database
# (caught on a real brain: ETAP 9's first real-world test). Add ambiguous tech at your peril.
TECH_GROUPS = {
    "relational-db": {"mysql", "mariadb", "postgres", "postgresql", "sqlite",
                      "mssql", "cockroachdb"},
    "host": {"ovh", "hetzner", "aws", "gcp", "azure", "digitalocean", "linode", "vultr"},
}
TECH_CANON = {"postgresql": "postgres"}


def find_tech(text):
    """Tech tokens present in text, grouped by mutually-exclusive category (canonicalized)."""
    low = text.lower()
    found = {}
    for group, toks in TECH_GROUPS.items():
        for tok in toks:
            if re.search(r"(?<![a-z0-9])" + re.escape(tok) + r"(?![a-z0-9])", low):
                found.setdefault(group, set()).add(TECH_CANON.get(tok, tok))
    return found


def parse_allow_conflict(val):
    """Frontmatter `allow_conflict:` -> set of tech groups this topic may legitimately name
    several of (a `{"*"}` sentinel means every group).

    For an *aggregator* topic — an infra topology map, a multi-repo roadmap/checklist — naming
    `mysql`, `postgres` and `sqlite` together is correct, not the stale-fact rot the conflict
    detector hunts. This is the human's narrow opt-out: tokens from a topic that allows a group
    are not tallied toward that group's per-project conflict. It does NOT silence conflicts that
    arise from *other* topics, so genuine drift elsewhere still surfaces.

    Accepts `true` / `all` (every group), or a list `[relational-db, host]` / comma string.
    """
    if not val:
        return set()
    v = re.split(r"\s+#", val, 1)[0].strip()  # drop a YAML-style inline ` # comment`
    if v.lower() in ("true", "all", "*", "yes"):
        return {"*"}
    return {t.strip().strip("'\"") for t in v.strip("[]").split(",") if t.strip()}


# --- --report grouping: classify a warning string into a section (default output is unchanged) ---
REPORT_SECTIONS = [
    ("conflict",      "Conflicts (contradictory facts)"),
    ("staleness",     "Staleness (re-confirm before trusting)"),
    ("cross-project", "Cross-project (possible mix-ups)"),
    ("provenance",    "Provenance"),
    ("tiers",         "Tiers"),
    ("compact",       "Compact index"),
    ("hygiene",       "Hygiene (size, orphans, fragmentation, session logs)"),
    ("index",         "Index"),
]


def categorize(msg):
    m = msg.lower()
    if "conflict" in m:  # "conflicting <group> …" and "conflict check skipped …"
        return "conflict"
    if "doesn't match" in m or "mentions other project" in m:  # folder OR person filename mix-up
        return "cross-project"
    if "stale" in m or "review_by" in m or "last_done" in m:
        return "staleness"
    if "invalid trust" in m:
        return "provenance"
    if "pinned {hot}" in m or "tier check skipped" in m:
        return "tiers"
    if "index.compact" in m or "compact consistency" in m:
        return "compact"
    if "status not recognised" in m:
        return "index"
    return "hygiene"  # thin/long topics, orphans, over-fragmentation, session-log overflow


def run_diff(brain, cutoff):
    """--diff: what changed in the brain since a date, from the brain's own dates (no git).

    Scans dated artifacts — topic last_done, session lines, resume lines, decisions (YYYY-MM),
    and people (status date + agreement lines) — and lists those on or after `cutoff`.
    """
    if parse_date(cutoff) is None:
        print(f"✗ --diff needs a YYYY-MM-DD date, got '{cutoff}'", file=sys.stderr)
        return 1
    cut_ym = cutoff[:7]
    index_text = read_text(os.path.join(brain, "index.md"))
    sections = {}  # ordered-by-insertion label -> [lines]

    def add(label, line):
        sections.setdefault(label, []).append(line)

    # topics + per-project session/decision logs
    pdir = os.path.join(brain, "projects")
    if os.path.isdir(pdir):
        for root, _dirs, files in os.walk(pdir):
            # label by the project folder, not the innermost dir — a topic parked in
            # projects/<p>/_archive/ belongs to <p>, and archived material stays out
            # of a "what changed" view (it was archived precisely to leave the map)
            rel_dir = os.path.relpath(root, pdir)
            if any(part.startswith("_") for part in rel_dir.split(os.sep) if part != "."):
                continue
            proj = rel_dir.split(os.sep)[0] if rel_dir != "." else ""
            for name in sorted(files):
                if not name.endswith(".md"):
                    continue
                full = os.path.join(root, name)
                if name in ("_session.md", "_session.cold.md"):
                    for ln in read_text(full).splitlines():
                        d = re.match(r"^(\d{4}-\d{2}-\d{2})\b", ln.strip())
                        if d and d.group(1) >= cutoff:
                            add("Session updates", f"{proj}: {ln.strip()}")
                elif name == "_decisions.md":
                    for ln in read_text(full).splitlines():
                        d = re.match(r"^(\d{4}-\d{2})\b", ln.strip())
                        if d and d.group(1) >= cut_ym:
                            add("Decisions", f"{proj}: {ln.strip()}")
                elif not name.startswith("_"):
                    fm = parse_frontmatter(read_text(full)) or {}
                    ld = fm.get("last_done")
                    if ld and parse_date(ld) and ld >= cutoff:
                        add("Topics", f"{proj}/{name[:-3]}  [{fm.get('status', '?')} · {ld}]")

    # resume lines (current "where we left off") from index.md
    for p in _compact.parse_index(index_text):
        rd = _compact._resume_date(p["resume"])
        if rd and rd >= cutoff:
            add("Resume", f"{p['name']}: {p['resume']}")

    # brain-wide decisions
    bd = os.path.join(brain, "decisions.md")
    if os.path.isfile(bd):
        for ln in read_text(bd).splitlines():
            d = re.match(r"^(\d{4}-\d{2})\b", ln.strip())
            if d and d.group(1) >= cut_ym:
                add("Decisions", f"(brain-wide): {ln.strip()}")

    # people: relationship date + dated agreement lines
    ppldir = os.path.join(brain, "people")
    if os.path.isdir(ppldir):
        for name in sorted(os.listdir(ppldir)):
            if not name.endswith(".md") or name.startswith("_"):
                continue
            text = read_text(os.path.join(ppldir, name))
            fm = parse_frontmatter(text) or {}
            ld = fm.get("last_done")
            if ld and parse_date(ld) and ld >= cutoff:
                add("People", f"{name[:-3]}  [{fm.get('status', '?')} · {ld}]")
            for ln in text.splitlines():
                d = re.match(r"^-?\s*(\d{4}-\d{2})\b", ln.strip())
                if d and d.group(1) >= cut_ym:
                    add("People", f"{name[:-3]} agreed: {ln.strip().lstrip('- ')}")

    print(f"Project Brain — changes since {cutoff}")
    total = sum(len(v) for v in sections.values())
    if not total:
        print("  (nothing dated on or after that day)")
        return 0
    for label in ("Topics", "Resume", "Session updates", "Decisions", "People"):
        if sections.get(label):
            print(f"\n  {label} ({len(sections[label])}):")
            for ln in sections[label]:
                print(f"    · {ln}")
    print(f"\n✓ {total} change(s) since {cutoff}.")
    return 0


def fix_compact(brain):
    """Regenerate index.compact if it's missing or out of date with index.md. Returns bool changed."""
    index = os.path.join(brain, "index.md")
    compact_path = os.path.join(brain, "index.compact")
    expected = _compact.render_compact(read_text(index), date.today().isoformat())
    if os.path.isfile(compact_path):
        if _compact.data_lines(read_text(compact_path)) == _compact.data_lines(expected):
            return False
    with open(compact_path, "w", encoding="utf-8") as fh:
        fh.write(expected)
    return True


def rotate_session_logs(brain):
    """Move each project's _session.md entries past the first 5 into _session.cold.md.

    _session.md is newest-first (one `> resume …` line per entry, blank-line separated,
    header lines start with `#`). The overflow (oldest) entries are PREPENDED into
    _session.cold.md, right after its own header — they are newer than whatever is
    already archived there, so newest-first order holds across both files together.
    Returns [(project, n_moved), ...] for projects actually rotated.
    """
    moved = []
    projects_dir = os.path.join(brain, "projects")
    if not os.path.isdir(projects_dir):
        return moved
    for proj in sorted(os.listdir(projects_dir)):
        pdir = os.path.join(projects_dir, proj)
        sp = os.path.join(pdir, "_session.md")
        if not os.path.isfile(sp):
            continue
        lines = read_text(sp).splitlines()
        i = 0
        header = []
        while i < len(lines) and (not lines[i].strip() or lines[i].strip().startswith("#")):
            header.append(lines[i])
            i += 1
        entries = [ln for ln in lines[i:] if ln.strip()]
        if len(entries) <= 5:
            continue
        keep, overflow = entries[:5], entries[5:]

        with open(sp, "w", encoding="utf-8") as fh:
            fh.write("\n".join(header).rstrip("\n") + "\n\n" + "\n\n".join(keep) + "\n")

        cp = os.path.join(pdir, "_session.cold.md")
        if os.path.isfile(cp):
            cold_lines = read_text(cp).splitlines()
            j = 0
            cold_header = []
            while j < len(cold_lines) and (not cold_lines[j].strip() or cold_lines[j].strip().startswith("#")):
                cold_header.append(cold_lines[j])
                j += 1
            cold_entries = [ln for ln in cold_lines[j:] if ln.strip()]
        else:
            cold_header = [f"# Session log (cold) — {proj} · oldest resume lines"]
            cold_entries = []
        merged = overflow + cold_entries
        with open(cp, "w", encoding="utf-8") as fh:
            fh.write("\n".join(cold_header).rstrip("\n") + "\n\n" + "\n\n".join(merged) + "\n")

        moved.append((proj, len(overflow)))
    return moved


def main():
    args = sys.argv[1:]
    strict = "--strict" in args
    report = "--report" in args
    fix = "--fix" in args

    diff_date = None
    if "--diff" in args:
        di = args.index("--diff")
        if di + 1 < len(args) and not args[di + 1].startswith("-"):
            diff_date = args[di + 1]
        else:
            print("✗ --diff needs a YYYY-MM-DD date (e.g. --diff 2026-05-01)", file=sys.stderr)
            return 1
    positional = [a for a in args if not a.startswith("-") and a != diff_date]
    arg = positional[0] if positional else None
    brain = find_brain(arg)
    if not brain:
        print("✗ No .project-brain found (looked in cwd / given path).")
        return 1

    index = os.path.join(brain, "index.md")
    if not os.path.isfile(index):
        print(f"✗ Missing index.md in {brain}")
        return 1

    if diff_date:  # --diff is its own focused view; it does not run the full validation
        return run_diff(brain, diff_date)

    if fix:
        compact_changed = fix_compact(brain)
        rotated = rotate_session_logs(brain)
        if compact_changed or rotated:
            print("brain-check --fix:")
            if compact_changed:
                print("  ✓ regenerated index.compact")
            for proj, n in rotated:
                print(f"  ✓ rotated {n} old line(s) from projects/{proj}/_session.md → _session.cold.md")
            print()
        else:
            print("brain-check --fix: nothing to fix (compact current, no session-log overflow)\n")

    errors, warnings = [], []
    today = date.today()

    # known project names = subfolders under projects/ (used for the cross-project guard)
    projects_dir = os.path.join(brain, "projects")
    project_names = set()
    if os.path.isdir(projects_dir):
        project_names = {
            n for n in os.listdir(projects_dir)
            if os.path.isdir(os.path.join(projects_dir, n)) and not n.startswith("_")
        }

    # 1. collect pointers from index.md
    linked = set()
    with open(index, encoding="utf-8") as fh:
        for i, line in enumerate(fh.read().splitlines(), 1):
            if "→" not in line:
                continue
            mp = re.search(r"((?:projects|people)/\S+\.md)", line)
            if not mp:
                continue
            rel = mp.group(1).split("#")[0]
            linked.add(rel)
            full = os.path.join(brain, rel)
            is_person = rel.startswith("people/")
            mb = re.search(r"\[([^\]]*)\]", line)
            idx_st = (people_status if is_person else index_status)(mb.group(1)) if mb else None

            if not os.path.isfile(full):
                errors.append(f"index.md:{i} pointer to missing file → {rel}")
                continue

            fm = parse_frontmatter(read_text(full))
            if fm is None:
                errors.append(f"{rel}: missing/broken frontmatter (--- block)")
                continue
            file_st = fm.get("status")
            if mb and idx_st is None:
                warnings.append(f"index.md:{i} status not recognised in [{mb.group(1)}]")
            elif idx_st and file_st and idx_st != file_st:
                errors.append(f"{rel}: status drift — index says '{idx_st}', file says '{file_st}'")

    # 2. validate every topic file on disk + find orphans / thin / fragmentation
    per_project = {}
    tech_sources = {}  # project -> group -> canon-token -> {sources} (for the conflict detector)
    if os.path.isdir(projects_dir):
        for root, _dirs, files in os.walk(projects_dir):
            for name in files:
                if not name.endswith(".md"):
                    continue
                if name.startswith("_"):
                    continue  # session logs / archives (_session.md, _*.cold.md) — not topics
                full = os.path.join(root, name)
                rel = os.path.relpath(full, brain)
                folder = os.path.basename(os.path.dirname(full))
                per_project[folder] = per_project.get(folder, 0) + 1

                text = read_text(full)
                fm = parse_frontmatter(text)
                if fm is None:
                    errors.append(f"{rel}: missing/broken frontmatter (--- block)")
                    continue

                missing = REQUIRED_KEYS - set(fm)
                if missing:
                    errors.append(f"{rel}: frontmatter missing keys: {', '.join(sorted(missing))}")
                st = fm.get("status")
                if st and st not in VALID_STATUS:
                    errors.append(f"{rel}: invalid status '{st}' (use: {', '.join(VALID_STATUS)})")

                # --- provenance: trust must be valid when present ---
                trust = fm.get("trust")
                if trust and trust not in VALID_TRUST:
                    warnings.append(f"{rel}: invalid trust '{trust}' (use: {' | '.join(VALID_TRUST)})")

                # --- cross-project guard: project: must match the folder ---
                file_proj = fm.get("project")
                if file_proj and folder and not folder.startswith("_") and file_proj != folder:
                    warnings.append(
                        f"{rel}: project '{file_proj}' doesn't match folder '{folder}' — "
                        f"possible cross-project mix-up (move the file or fix `project:`)"
                    )

                # --- cross-project guard (--strict): name-dropping another project in the body ---
                # Off by default: coupled brains reference each other on purpose, so flagging every
                # legitimate mention is noise. Opt in with --strict for stricter project isolation.
                if strict:
                    declared = fm.get("cross_refs", "")
                    for other in project_names:
                        if other in (folder, file_proj) or len(other) < 4 or other in declared:
                            continue
                        if re.search(r"\b" + re.escape(other) + r"\b", text):
                            warnings.append(
                                f"{rel}: mentions other project '{other}' — confirm it belongs here, "
                                f"or add it to `cross_refs:`"
                            )

                # --- staleness: a finished claim that needs re-confirming ---
                if st in FINISHED_STATUS:
                    review_by = fm.get("review_by")
                    last_done = fm.get("last_done")
                    if review_by:
                        d = parse_date(review_by)
                        if d is None:
                            warnings.append(f"{rel}: review_by '{review_by}' is not a YYYY-MM-DD date")
                        elif today > d:
                            warnings.append(
                                f"{rel}: stale — review_by {review_by} has passed; re-confirm before trusting"
                            )
                    elif last_done:
                        d = parse_date(last_done)
                        if d is None:
                            warnings.append(f"{rel}: last_done '{last_done}' is not a YYYY-MM-DD date")
                        elif (today - d).days > STALE_DAYS:
                            warnings.append(
                                f"{rel}: stale — {st} topic last confirmed {last_done} "
                                f"(> {STALE_DAYS} days ago); re-verify before trusting"
                            )

                # --- advisory: size / orphan ---
                if os.path.getsize(full) < THIN_BYTES:
                    warnings.append(f"{rel}: thin topic (<{THIN_BYTES} B) — consider merging")
                body = text[m.end():] if (m := re.match(r"---\s*\n.*?\n---", text, re.S)) else text
                body_lines = sum(1 for ln in body.splitlines() if ln.strip())
                if body_lines > MAX_BODY_LINES:
                    warnings.append(
                        f"{rel}: {body_lines} body lines (>{MAX_BODY_LINES}) — too long, "
                        f"split or trim (memory hygiene)"
                    )
                if rel not in linked:
                    warnings.append(f"{rel}: not linked from index.md (orphan)")

                # --- conflict detector: gather exclusive tech tokens this topic names ---
                # An aggregator topic can opt out via `allow_conflict:` so its legitimate
                # multi-tech listing is not tallied (narrow: other topics still conflict).
                allowed = parse_allow_conflict(fm.get("allow_conflict"))
                unknown = {g for g in allowed if g != "*"} - set(TECH_GROUPS)
                if unknown:
                    warnings.append(
                        f"{rel}: allow_conflict names unknown group(s) {', '.join(sorted(unknown))} "
                        f"— valid: {', '.join(sorted(TECH_GROUPS))}"
                    )
                for group, toks in find_tech(text).items():
                    if "*" in allowed or group in allowed:
                        continue  # human vouched this topic legitimately names several
                    for canon in toks:
                        (tech_sources.setdefault(folder, {})
                                     .setdefault(group, {})
                                     .setdefault(canon, set()).add(rel))

    for proj, n in per_project.items():
        if n > _compact.TOPIC_THRESHOLD:
            warnings.append(
                f"project '{proj}' has {n} topics (>{_compact.TOPIC_THRESHOLD}) — compact "
                f"auto-collapses the older finished ones now, but the files themselves still "
                f"add drill-down overhead; consider consolidating"
            )

    # 3. validate people/<slug>.md — agreements with humans, same validation spirit as topics
    people_dir = os.path.join(brain, "people")
    people_count = 0
    if os.path.isdir(people_dir):
        for name in sorted(os.listdir(people_dir)):
            if not name.endswith(".md") or name.startswith("_"):
                continue
            rel = "people/" + name
            full = os.path.join(people_dir, name)
            people_count += 1
            text = read_text(full)
            fm = parse_frontmatter(text)
            if fm is None:
                errors.append(f"{rel}: missing/broken frontmatter (--- block)")
                continue
            missing = PEOPLE_REQUIRED - set(fm)
            if missing:
                errors.append(f"{rel}: frontmatter missing keys: {', '.join(sorted(missing))}")
            st = fm.get("status")
            if st and st not in PEOPLE_STATUS:
                errors.append(f"{rel}: invalid status '{st}' (use: {', '.join(PEOPLE_STATUS)})")
            trust = fm.get("trust")
            if trust and trust not in VALID_TRUST:
                warnings.append(f"{rel}: invalid trust '{trust}' (use: {' | '.join(VALID_TRUST)})")
            slug = name[:-3]
            if fm.get("person") and fm["person"] != slug:
                warnings.append(f"{rel}: person '{fm['person']}' doesn't match filename '{slug}' — fix one")
            review_by, last_done = fm.get("review_by"), fm.get("last_done")
            if review_by:
                d = parse_date(review_by)
                if d is None:
                    warnings.append(f"{rel}: review_by '{review_by}' is not a YYYY-MM-DD date")
                elif today > d:
                    warnings.append(f"{rel}: stale — review_by {review_by} has passed; re-confirm before trusting")
            elif last_done:
                d = parse_date(last_done)
                if d is None:
                    warnings.append(f"{rel}: last_done '{last_done}' is not a YYYY-MM-DD date")
                elif (today - d).days > STALE_DAYS:
                    warnings.append(f"{rel}: stale — last contact {last_done} (> {STALE_DAYS} days ago); re-confirm")
            if rel not in linked:
                warnings.append(f"{rel}: not linked from index.md # People (orphan)")

    # conflict detector: fold in each project's declared stack from index.md, then flag any
    # project that names two of the same mutually-exclusive category (relational DB / host)
    try:
        for p in _compact.parse_index(read_text(index)):
            for group, toks in find_tech(" ".join(p["stack"])).items():
                for canon in toks:
                    (tech_sources.setdefault(p["name"], {})
                                 .setdefault(group, {})
                                 .setdefault(canon, set()).add("index.md (stack)"))
    except Exception as exc:
        warnings.append(f"conflict check skipped ({exc})")
    for proj in sorted(tech_sources):
        for group in sorted(tech_sources[proj]):
            canons = tech_sources[proj][group]
            if len(canons) > 1:
                detail = "; ".join(
                    f"{c} ({', '.join(sorted(srcs))})" for c, srcs in sorted(canons.items())
                )
                warnings.append(
                    f"project '{proj}': conflicting {group} — {detail} — "
                    f"same project names two; reconcile, or note it is a migration"
                )

    # session logs: keep the active per-project log to <= 5 lines (older rotates to _session.cold.md)
    if os.path.isdir(projects_dir):
        for proj in sorted(os.listdir(projects_dir)):
            sp = os.path.join(projects_dir, proj, "_session.md")
            if os.path.isfile(sp):
                n = sum(
                    1 for ln in read_text(sp).splitlines()
                    if ln.strip() and not ln.strip().startswith("#")
                )
                if n > 5:
                    warnings.append(
                        f"projects/{proj}/_session.md has {n} active lines (>5) — "
                        f"rotate the oldest into _session.cold.md"
                    )

    # tiers: more than HOT_MAX {hot} pins — only the first HOT_MAX are honored, extras go WARM
    try:
        pins = [p["name"] for p in _compact.parse_index(read_text(index)) if p["hot"]]
        if len(pins) > _compact.HOT_MAX:
            warnings.append(
                f"{len(pins)} projects pinned {{hot}} but only {_compact.HOT_MAX} fit HOT — "
                f"extras render as WARM: {', '.join(pins[_compact.HOT_MAX:])}"
            )
    except Exception as exc:
        warnings.append(f"tier check skipped ({exc})")

    # compact index: must reflect index.md (advisory — agents fall back to index.md if absent/stale)
    compact_path = os.path.join(brain, "index.compact")
    try:
        expected = _compact.render_compact(read_text(index))
        if not os.path.isfile(compact_path):
            warnings.append(
                "index.compact missing — run `brain-compact` to generate it "
                "(agents read it first; they fall back to index.md, so this is advisory)"
            )
        elif _compact.data_lines(read_text(compact_path)) != _compact.data_lines(expected):
            warnings.append(
                "index.compact is out of date with index.md — run `brain-compact` to regenerate"
            )
    except Exception as exc:  # never let the advisory check fail the validator
        warnings.append(f"compact consistency check skipped ({exc})")

    total = sum(per_project.values())
    ppl = f" + {people_count} person file(s)" if people_count else ""

    # report
    if report:
        print("Project Brain — report")
        print(f"  brain: {brain}")
        print(f"  {total} topic file(s) across {len(per_project)} project folder(s){ppl}")
        if errors:
            print(f"\n  Errors ({len(errors)}) — must fix:")
            for e in errors:
                print(f"    ✗ {e}")
        for key, title in REPORT_SECTIONS:
            items = [w for w in warnings if categorize(w) == key]
            if items:
                print(f"\n  {title} ({len(items)}):")
                for w in items:
                    print(f"    ⚠ {w}")
        if not errors and not warnings:
            print("\n  ✓ clean — no errors, no warnings")
    else:
        for w in warnings:
            print(f"⚠ {w}")
        for e in errors:
            print(f"✗ {e}")

    ver = skill_version()
    tag = f"  [brain-check {ver}]" if ver else ""
    if errors:
        print(f"\n✗ {len(errors)} error(s), {len(warnings)} warning(s) across {total} topic file(s){ppl}.{tag}")
        return 1
    print(f"\n✓ Brain OK — {total} topic file(s){ppl}, {len(warnings)} warning(s).{tag}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
